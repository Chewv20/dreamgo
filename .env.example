APP_ENV=local
APP_URL=http://dreamgo.local

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dreamgo
DB_USER=root
DB_PASS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@dreamgooperadoraturistica.com
SMTP_FROM_NAME="Dream Go Operadora Turistica"
SMTP_SECURE=tls

# Mercado Pago (Checkout Pro) - reserva y pago en linea del anticipo.
# MP_ACCESS_TOKEN: credencial privada de tu cuenta/app de Mercado Pago (Access Token de
#   produccion o de prueba, segun el entorno). Sin esto, el checkout no se activa: la reserva
#   se sigue creando igual, solo que sin pago en linea (ver ReservaPublicaController::crear).
# MP_WEBHOOK_SECRET: "Clave secreta" que Mercado Pago asigna a la notificacion webhook
#   configurada en tu panel de desarrollador, para validar el header x-signature. Sin esto el
#   webhook sigue funcionando pero sin verificar que la notificacion venga realmente de
#   Mercado Pago (queda registrado en el log como advertencia).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Analitica y publicidad (opcional). Vacio = desactivado: no se carga ningun script de
# terceros ni aparece el banner de cookies. Al poner un ID valido, el sitio publico carga
# la herramienta SOLO despues de que el visitante acepte en el banner de consentimiento.
# GA4_MEASUREMENT_ID: ID de medicion de Google Analytics 4, formato G-XXXXXXXXXX.
# META_PIXEL_ID: ID del pixel de Meta / Facebook, solo digitos.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
