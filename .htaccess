# Raiz del proyecto. En Hostinger el proyecto queda directo en public_html (el Document Root
# no se puede mover a public/ y no se usan virtual hosts), asi que toda peticion se reescribe
# internamente a public/. Con eso app/, core/, config/, storage/, vendor/ y .env nunca se
# sirven: /app/... o /.env acaban en public/app/... o public/.env, que no existen o estan
# denegados, y responde el 404 de la app. Si el Document Root si apunta a public/, este
# archivo ni se lee.
RewriteEngine On

# www -> dominio sin www (evita contenido duplicado; el canonical ya apunta sin www).
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# HTTPS antes de reescribir, para que el redirect no exponga /public en la URL. Misma
# condicion que public/.htaccess (cubre el CDN de Hostinger, que termina el TLS).
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# El /public/... pedido directo lo redirige public/.htaccess a la URL sin /public.
RewriteRule ^(.*)$ public/$1 [L]

# Defensa extra si mod_rewrite fallara: archivos sensibles de la raiz.
<FilesMatch "^(\.env.*|composer\.(json|lock)|.*\.(md|sql|log))$">
    Require all denied
</FilesMatch>
