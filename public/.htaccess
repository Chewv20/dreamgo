RewriteEngine On

# El .htaccess de la raíz del proyecto deniega todo por defecto;
# esta carpeta es la única que debe quedar accesible desde el navegador.
Require all granted

# Bloquea el acceso directo a archivos sensibles si llegaran a existir en public/
<FilesMatch "\.(env|sql|log|md)$">
    Require all denied
</FilesMatch>

# Auditoria 2026-08-25, hallazgo CFG-04: sin esto, cada visita revalidaba CSS/JS/fuentes/
# imagenes de assets/ sin ningun cache de largo plazo ni compresion.
#
# CSS/JS: 1 semana. En el HTML se referencian con `?v=<mtime>` (App\Helpers\Asset::url, ver
# app/Views/layouts/*), asi que un cambio en el archivo cambia la URL y el navegador pide la
# version nueva de inmediato -- ya no hace falta el cache corto de 1 dia. No se pone `immutable`
# ni 1 año porque public/sw.js todavia precachea las URLs sin `?v=` (SHELL_ASSETS) y no puede
# leer el mtime; 1 semana acota cuanto puede quedar desincronizada esa copia tras un deploy.
# Fuentes e imagenes son estables entre deploys: cache largo.
<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(css|js)$">
        ExpiresDefault "access plus 1 week"
    </FilesMatch>
    <FilesMatch "\.(woff2?|avif|webp|png|jpe?g|svg|ico)$">
        ExpiresDefault "access plus 1 year"
    </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.(woff2?|avif|webp|png|jpe?g|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [QSA,L]
